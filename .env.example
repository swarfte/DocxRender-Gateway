PORT=3000
NODE_ENV=production

# Optional. If empty, the service reads or generates /app/secrets/api-token
API_TOKEN=

MAX_TEMPLATE_BYTES=26214400
MAX_DATA_BYTES=10485760
MAX_TOTAL_BYTES=36700160

RENDER_TIMEOUT_MS=120000
MAX_CONCURRENT_RENDERS=2

DEFAULT_IMAGE_WIDTH=300
DEFAULT_IMAGE_HEIGHT=300

LOG_LEVEL=info

# Image URLs ({%logo} with an http(s) URL value)
IMAGE_URL_ENABLED=true
# Comma-separated host allowlist; empty = any public host
IMAGE_URL_ALLOWED_HOSTS=
MAX_IMAGE_BYTES=5242880
IMAGE_FETCH_TIMEOUT_MS=10000
